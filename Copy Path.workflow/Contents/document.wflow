				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string>export LANG=en_US.UTF-8

out=""
for f in "$@"
do
    if [ -z "$out" ]; then
        out="$f"
    else
        out="$out
$f"
    fi
done

printf '%s' "$out" | pbcopy

if [ "$#" -eq 1 ]; then
    msg="$out"
else
    msg="$# paths copied"
fi
osascript - "$msg" &gt;/dev/null 2&gt;&amp;1 &lt;&lt;'APPLESCRIPT' &amp;
on run argv
    display notification (item 1 of argv) with title "Copy Path"
end run
APPLESCRIPT
disown 2&gt;/dev/null || true</string>
